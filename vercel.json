{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma migrate deploy && prisma generate && next build",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/cron/whatsapp-return",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/billing",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/automations",
      "schedule": "0 11 * * *"
    }
  ]
}
