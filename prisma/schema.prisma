// Money: amounts are stored as Decimal in the DB (e.g. Decimal(12,2)).
// The application converts to/from integer cents at API and payment boundaries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
  CLUBE
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  BARBER
  RECEPTIONIST
}

enum PaymentMethod {
  PIX
  CASH
  CARD
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentOrigin {
  INTERNAL
  PUBLIC
  WALK_IN
  WHATSAPP
  WAITLIST
  RECURRING
}

enum BlockType {
  LUNCH
  TIME_OFF
  VACATION
  HOLIDAY
  BLOCK
}

enum MembershipBilling {
  MONTHLY
  ONE_TIME
}

enum MembershipPlanType {
  MONTHLY_LIMITED
  MONTHLY_UNLIMITED
  VISIT_PACK
  LOYALTY
}

enum MembershipStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum WhatsAppMessageStatus {
  PENDING
  SENT
  FAILED
  SIMULATED
}

enum WhatsAppMessageType {
  RETURN
  CONFIRMATION
  REMINDER
  BIRTHDAY
  PROMOTION
  MANUAL
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum SignupCheckoutStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
}

enum PublicBookingCheckoutStatus {
  PENDING_PAYMENT
  AWAITING_CONFIRMATION
  PAID
  EXPIRED
  CANCELLED
}

enum WaitlistStatus {
  PENDING
  OFFERED
  BOOKED
  EXPIRED
  CANCELLED
}

enum BarberTimeOffType {
  TIME_OFF
  VACATION
  SICK
  HOLIDAY
  OTHER
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SUPPLY
  BLEED
  ADJUSTMENT
  SALE
  REFUND
}

enum SaleStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum SaleItemKind {
  SERVICE
  PRODUCT
}

enum SalePaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum SalePaymentSource {
  PAID_PROVIDER
  PAID_MANUAL
  PENDING
  FAILED
  REFUNDED
  CANCELLED
}

enum CommissionRuleType {
  PERCENTAGE
  FIXED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  SALE
  RETURN
}

enum ConsentType {
  WHATSAPP
  MARKETING
  DATA_PROCESSING
  PHOTO
}

enum DomainEventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum MessageOutboxStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

enum LoyaltyLedgerType {
  EARN
  REDEEM
  ADJUSTMENT
  EXPIRE
}

enum ReferralStatus {
  PENDING
  COMPLETED
  REWARDED
  CANCELLED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum FiscalDocumentStatus {
  PENDING
  ISSUED
  FAILED
  CANCELLED
}

model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  phone        String?
  address      String?
  plan         Plan     @default(FREE)
  active       Boolean  @default(true)
  billingEmail String?
  subscribedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                  User[]
  clients                Client[]
  services               Service[]
  appointments           Appointment[]
  settings               TenantSettings?
  membershipPlans        MembershipPlan[]
  clientMemberships      ClientMembership[]
  whatsappMessages       WhatsAppMessage[]
  subscriptionPayments   SubscriptionPayment[]
  signupCheckout         SignupCheckout?
  publicBookingCheckouts PublicBookingCheckout[]

  auditLogs             AuditLog[]
  locations             Location[]
  barberSchedules       BarberSchedule[]
  barberTimeOffs        BarberTimeOff[]
  appointmentHistory    AppointmentHistory[]
  waitlistEntries       WaitlistEntry[]
  membershipRedemptions MembershipRedemption[]
  cashSessions          CashSession[]
  cashMovements         CashMovement[]
  sales                 Sale[]
  saleItems             SaleItem[]
  salePayments          SalePayment[]
  saleRefunds           SaleRefund[]
  expenseCategories     ExpenseCategory[]
  expenses              Expense[]
  commissionRules       CommissionRule[]
  commissionEntries     CommissionEntry[]
  productCategories     ProductCategory[]
  products              Product[]
  stockMovements        StockMovement[]
  clientTags            ClientTag[]
  clientConsents        ClientConsent[]
  clientFavorites       ClientFavorite[]
  domainEvents          DomainEvent[]
  automationRules       AutomationRule[]
  messageOutbox         MessageOutbox[]
  giftCards             GiftCard[]
  loyaltyAccounts       LoyaltyAccount[]
  loyaltyLedger         LoyaltyLedger[]
  referrals             Referral[]
  servicePackages       ServicePackage[]
  prepaidCredits        PrepaidCredit[]
  coupons               Coupon[]
  reviews               Review[]
  fiscalDocuments       FiscalDocument[]
  permissionOverrides   PermissionOverride[]
}

model SignupCheckout {
  id                      String               @id @default(cuid())
  status                  SignupCheckoutStatus @default(PENDING)
  plan                    Plan
  amount                  Decimal              @db.Decimal(10, 2)
  barbershopName          String
  slug                    String
  ownerName               String
  ownerEmail              String
  passwordHash            String
  phone                   String?
  mercadoPagoPreferenceId String?
  mercadoPagoPaymentId    String?
  tenantId                String?              @unique
  tenant                  Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  paidAt                  DateTime?
  expiresAt               DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@unique([mercadoPagoPaymentId])
  @@index([ownerEmail])
  @@index([status])
  @@index([mercadoPagoPreferenceId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(BARBER)
  active       Boolean  @default(true)
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments        Appointment[]           @relation("BarberAppointments")
  locationAccess      UserLocationAccess[]
  barberSchedules     BarberSchedule[]
  barberTimeOffs      BarberTimeOff[]
  serviceBarbers      ServiceBarber[]
  appointmentHistory  AppointmentHistory[]    @relation("AppointmentHistoryActor")
  confirmedBookings   PublicBookingCheckout[] @relation("ConfirmedByUser")
  waitlistEntries     WaitlistEntry[]
  cashSessions        CashSession[]           @relation("CashSessionOperator")
  cashMovements       CashMovement[]          @relation("CashMovementCreator")
  sales               Sale[]                  @relation("SaleOperator")
  saleItems           SaleItem[]              @relation("SaleItemBarber")
  saleRefunds         SaleRefund[]            @relation("SaleRefundUser")
  expenses            Expense[]               @relation("ExpenseCreator")
  commissionRules     CommissionRule[]
  commissionEntries   CommissionEntry[]
  clientFavorites     ClientFavorite[]
  permissionOverrides PermissionOverride[]
  auditLogs           AuditLog[]              @relation("AuditLogActor")

  @@index([tenantId])
}

model Client {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  phone               String
  birthday            DateTime?
  photoUrl            String?   @db.Text
  notes               String?
  lastVisitAt         DateTime?
  lastReturnMessageAt DateTime?
  returnDays          Int       @default(20)
  whatsappOptIn       Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  appointments      Appointment[]
  memberships       ClientMembership[]
  waitlistEntries   WaitlistEntry[]
  sales             Sale[]
  tagAssignments    ClientTagAssignment[]
  consents          ClientConsent[]
  favorites         ClientFavorite[]
  giftCards         GiftCard[]
  loyaltyAccount    LoyaltyAccount?
  referralsMade     Referral[]            @relation("ReferrerReferrals")
  referralsReceived Referral[]            @relation("ReferredReferrals")
  prepaidCredits    PrepaidCredit[]
  reviews           Review[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Service {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  price     Decimal  @db.Decimal(10, 2)
  duration  Int      @default(30)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  appointments    Appointment[]
  serviceBarbers  ServiceBarber[]
  waitlistEntries WaitlistEntry[]
  commissionRules CommissionRule[]
  saleItems       SaleItem[]
  clientFavorites ClientFavorite[]

  @@index([tenantId])
}

model Appointment {
  id              String                 @id @default(cuid())
  tenantId        String
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client                 @relation(fields: [clientId], references: [id])
  serviceId       String
  service         Service                @relation(fields: [serviceId], references: [id])
  barberId        String?
  barber          User?                  @relation("BarberAppointments", fields: [barberId], references: [id])
  scheduledAt     DateTime
  duration        Int                    @default(30)
  price           Decimal                @db.Decimal(10, 2)
  paymentMethod   PaymentMethod?
  status          AppointmentStatus      @default(SCHEDULED)
  notes           String?
  bookedOnline    Boolean                @default(false)
  membershipId    String?
  membership      ClientMembership?      @relation(fields: [membershipId], references: [id])
  bookingCheckout PublicBookingCheckout?
  locationId      String?
  location        Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  checkedInAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  origin          AppointmentOrigin?
  customDuration  Int?
  blockType       BlockType?
  waitlistEntryId String?
  waitlistEntry   WaitlistEntry?         @relation(fields: [waitlistEntryId], references: [id], onDelete: SetNull)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  history               AppointmentHistory[]
  membershipRedemptions MembershipRedemption[]
  sales                 Sale[]
  saleItems             SaleItem[]
  reviews               Review[]

  @@index([tenantId, scheduledAt])
  @@index([tenantId, status])
  @@index([tenantId, locationId])
  @@index([barberId])
  @@index([waitlistEntryId])
}

model TenantSettings {
  id                       String    @id @default(cuid())
  tenantId                 String    @unique
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappEnabled          Boolean   @default(false)
  whatsappPhoneNumberId    String?
  whatsappAccessToken      String?   @db.Text
  whatsappReturnTemplate   String    @default("Fala {nome}! Já faz {dias} dias do seu último corte na {barbearia}. Bora marcar? Responda aqui que a gente agenda! ✂️")
  autoReturnEnabled        Boolean   @default(false)
  returnMessageDays        Int       @default(20)
  lastBulkSendAt           DateTime?
  openTime                 String    @default("08:00")
  closeTime                String    @default("20:00")
  workingDays              String    @default("1,2,3,4,5,6")
  publicBookingEnabled     Boolean   @default(true)
  bookingNotifyPhone       String?
  bookingRequirePixPayment Boolean   @default(false)
  bookingPixKey            String?
  bookingPixHolderName     String?
  bookingPixCity           String?   @default("SAO PAULO")
  mercadoPagoAccessToken   String?   @db.Text
  timeZone                 String    @default("America/Sao_Paulo")
  bufferBeforeMinutes      Int       @default(0)
  bufferAfterMinutes       Int       @default(0)
}

model PublicBookingCheckout {
  id                   String                      @id @default(cuid())
  tenantId             String
  tenant               Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status               PublicBookingCheckoutStatus @default(PENDING_PAYMENT)
  clientName           String
  clientPhone          String
  serviceId            String
  barberId             String?
  scheduledAt          DateTime
  amount               Decimal                     @db.Decimal(10, 2)
  mercadoPagoPaymentId String?
  appointmentId        String?                     @unique
  appointment          Appointment?                @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  expiresAt            DateTime
  paidAt               DateTime?
  serviceName          String?
  serviceDuration      Int?
  servicePrice         Decimal?                    @db.Decimal(12, 2)
  barberName           String?
  currency             String                      @default("BRL")
  paymentSource        String? // PAID_PROVIDER | PAID_MANUAL | etc
  confirmedByUserId    String?
  confirmedByUser      User?                       @relation("ConfirmedByUser", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  confirmationNote     String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@unique([mercadoPagoPaymentId])
  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@index([expiresAt])
}

model WhatsAppMessage {
  id        String                @id @default(cuid())
  tenantId  String
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String?
  phone     String
  message   String                @db.Text
  type      WhatsAppMessageType   @default(RETURN)
  status    WhatsAppMessageStatus @default(PENDING)
  error     String?
  sentAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([tenantId, createdAt])
  @@index([clientId])
}

model MembershipPlan {
  id                String             @id @default(cuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  description       String?            @db.Text
  price             Decimal            @db.Decimal(10, 2)
  billingCycle      MembershipBilling  @default(MONTHLY)
  planType          MembershipPlanType @default(MONTHLY_LIMITED)
  maxVisitsPerMonth Int?
  totalVisits       Int?
  allowedWeekdays   String             @default("0,1,2,3,4,5,6")
  bonusAfterVisits  Int?
  bonusDescription  String?
  active            Boolean            @default(true)
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  memberships ClientMembership[]

  @@index([tenantId])
}

model ClientMembership {
  id                   String           @id @default(cuid())
  tenantId             String
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId             String
  client               Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  planId               String
  plan                 MembershipPlan   @relation(fields: [planId], references: [id])
  status               MembershipStatus @default(ACTIVE)
  startedAt            DateTime         @default(now())
  expiresAt            DateTime?
  periodStartAt        DateTime         @default(now())
  visitsUsedThisPeriod Int              @default(0)
  totalVisitsUsed      Int              @default(0)
  bonusEarned          Int              @default(0)
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  appointments Appointment[]
  redemptions  MembershipRedemption[]

  @@index([tenantId])
  @@index([clientId])
  @@index([status])
}

model SubscriptionPayment {
  id                   String                    @id @default(cuid())
  tenantId             String
  tenant               Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                 Plan
  amount               Decimal                   @db.Decimal(10, 2)
  status               SubscriptionPaymentStatus @default(PENDING)
  dueDate              DateTime
  paidAt               DateTime?
  tenantReportedPaidAt DateTime?
  notes                String?
  createdAt            DateTime                  @default(now())

  @@index([tenantId])
  @@index([status, dueDate])
}

// ---------------------------------------------------------------------------
// Audit & webhooks
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUserId String?
  actorUser   User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  metadata    String?  @db.Text
  ip          String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
}

model ProcessedWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventKey    String
  payloadHash String?
  processedAt DateTime @default(now())
  status      String   @default("PROCESSING") // PROCESSING | PROCESSED | FAILED
  result      String?

  @@unique([provider, eventKey])
  @@index([processedAt])
}

// ---------------------------------------------------------------------------
// Locations & scheduling
// ---------------------------------------------------------------------------

model Location {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  address   String?
  phone     String?
  active    Boolean  @default(true)
  isPrimary Boolean  @default(false)
  timezone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userAccess      UserLocationAccess[]
  barberSchedules BarberSchedule[]
  appointments    Appointment[]
  sales           Sale[]
  cashSessions    CashSession[]
  expenses        Expense[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, active])
}

model UserLocationAccess {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@index([locationId])
}

model BarberSchedule {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barberId   String
  barber     User      @relation(fields: [barberId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  weekday    Int
  startTime  String
  endTime    String
  active     Boolean   @default(true)

  breaks BarberScheduleBreak[]

  @@index([tenantId, barberId])
  @@index([tenantId, locationId])
  @@index([barberId, weekday])
}

model BarberScheduleBreak {
  id         String         @id @default(cuid())
  scheduleId String
  schedule   BarberSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  startTime  String
  endTime    String

  @@index([scheduleId])
}

model BarberTimeOff {
  id       String            @id @default(cuid())
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barberId String
  barber   User              @relation(fields: [barberId], references: [id], onDelete: Cascade)
  startsAt DateTime
  endsAt   DateTime
  reason   String?
  type     BarberTimeOffType @default(TIME_OFF)

  @@index([tenantId, barberId])
  @@index([barberId, startsAt, endsAt])
}

model ServiceBarber {
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  barberId  String
  barber    User    @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@id([serviceId, barberId])
  @@index([barberId])
}

// ---------------------------------------------------------------------------
// Appointments & waitlist
// ---------------------------------------------------------------------------

model AppointmentHistory {
  id            String             @id @default(cuid())
  appointmentId String
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUserId   String?
  actorUser     User?              @relation("AppointmentHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus?
  changes       String?            @db.Text
  createdAt     DateTime           @default(now())

  @@index([tenantId, createdAt])
  @@index([appointmentId])
}

model WaitlistEntry {
  id                 String         @id @default(cuid())
  tenantId           String
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId           String?
  client             Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName         String
  clientPhone        String
  serviceId          String
  service            Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  barberId           String?
  barber             User?          @relation(fields: [barberId], references: [id], onDelete: SetNull)
  preferredDates     String?
  preferredTimeStart String?
  preferredTimeEnd   String?
  priority           Int            @default(0)
  notes              String?
  status             WaitlistStatus @default(PENDING)
  offerExpiresAt     DateTime?
  offeredSlotAt      DateTime?
  createdAt          DateTime       @default(now())

  appointments Appointment[]

  @@index([tenantId, status])
  @@index([tenantId, serviceId])
  @@index([clientId])
}

model MembershipRedemption {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipId   String
  membership     ClientMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  appointmentId  String?
  appointment    Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  saleItemId     String?
  saleItem       SaleItem?        @relation(fields: [saleItemId], references: [id], onDelete: SetNull)
  redeemedAt     DateTime         @default(now())
  periodKey      String
  idempotencyKey String           @unique

  @@index([tenantId])
  @@index([membershipId, periodKey])
}

// ---------------------------------------------------------------------------
// Cash drawer & sales (comanda)
// ---------------------------------------------------------------------------

model CashSession {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId      String?
  location        Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  operatorUserId  String
  operatorUser    User              @relation("CashSessionOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)
  status          CashSessionStatus @default(OPEN)
  openingBalance  Decimal           @db.Decimal(12, 2)
  closingBalance  Decimal?          @db.Decimal(12, 2)
  expectedBalance Decimal?          @db.Decimal(12, 2)
  openedAt        DateTime          @default(now())
  closedAt        DateTime?
  notes           String?

  movements CashMovement[]
  sales     Sale[]

  @@index([tenantId, status])
  @@index([tenantId, locationId])
  @@index([operatorUserId])
}

model CashMovement {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId       String
  session         CashSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type            CashMovementType
  amount          Decimal          @db.Decimal(12, 2)
  notes           String?
  idempotencyKey  String?
  createdByUserId String?
  createdByUser   User?            @relation("CashMovementCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())

  @@unique([idempotencyKey])
  @@index([tenantId])
  @@index([sessionId])
}

model Sale {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status         SaleStatus   @default(DRAFT)
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  locationId     String?
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  cashSessionId  String?
  cashSession    CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  operatorUserId String
  operatorUser   User         @relation("SaleOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)
  subtotal       Decimal      @default(0) @db.Decimal(12, 2)
  discount       Decimal      @default(0) @db.Decimal(12, 2)
  surcharge      Decimal      @default(0) @db.Decimal(12, 2)
  tip            Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  closedAt       DateTime?

  items           SaleItem[]
  payments        SalePayment[]
  refunds         SaleRefund[]
  fiscalDocuments FiscalDocument[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([clientId])
  @@index([appointmentId])
}

model SaleItem {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleId        String
  sale          Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  kind          SaleItemKind
  serviceId     String?
  service       Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  barberId      String?
  barber        User?        @relation("SaleItemBarber", fields: [barberId], references: [id], onDelete: SetNull)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  name          String
  quantity      Int          @default(1)
  unitPrice     Decimal      @db.Decimal(12, 2)
  discount      Decimal      @default(0) @db.Decimal(12, 2)
  total         Decimal      @db.Decimal(12, 2)

  membershipRedemptions MembershipRedemption[]
  commissionEntries     CommissionEntry[]

  @@index([tenantId])
  @@index([saleId])
}

model SalePayment {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleId      String
  sale        Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method      PaymentMethod
  amount      Decimal           @db.Decimal(12, 2)
  status      SalePaymentStatus @default(PENDING)
  providerRef String?
  source      SalePaymentSource @default(PENDING)
  createdAt   DateTime          @default(now())

  refunds SaleRefund[]

  @@index([tenantId])
  @@index([saleId])
}

model SaleRefund {
  id               String       @id @default(cuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleId           String
  sale             Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentId        String?
  payment          SalePayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amount           Decimal      @db.Decimal(12, 2)
  reason           String?
  refundedByUserId String?
  refundedByUser   User?        @relation("SaleRefundUser", fields: [refundedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())

  @@index([tenantId])
  @@index([saleId])
}

// ---------------------------------------------------------------------------
// Expenses
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  expenses Expense[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Expense {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId      String
  category        ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  locationId      String?
  location        Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  amount          Decimal         @db.Decimal(12, 2)
  description     String?
  paidAt          DateTime        @default(now())
  createdByUserId String?
  createdByUser   User?           @relation("ExpenseCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())

  @@index([tenantId, paidAt])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Commissions
// ---------------------------------------------------------------------------

model CommissionRule {
  id        String             @id @default(cuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  type      CommissionRuleType @default(PERCENTAGE)
  rate      Decimal            @db.Decimal(12, 4)
  serviceId String?
  service   Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  barberId  String?
  barber    User?              @relation(fields: [barberId], references: [id], onDelete: SetNull)
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  entries CommissionEntry[]

  @@index([tenantId])
  @@index([tenantId, active])
}

model CommissionEntry {
  id         String          @id @default(cuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ruleId     String?
  rule       CommissionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  barberId   String
  barber     User            @relation(fields: [barberId], references: [id], onDelete: Restrict)
  saleItemId String?
  saleItem   SaleItem?       @relation(fields: [saleItemId], references: [id], onDelete: SetNull)
  amount     Decimal         @db.Decimal(12, 2)
  periodKey  String
  createdAt  DateTime        @default(now())

  @@unique([saleItemId])
  @@index([tenantId, periodKey])
  @@index([barberId, periodKey])
}

// ---------------------------------------------------------------------------
// Products & inventory
// ---------------------------------------------------------------------------

model ProductCategory {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id         String           @id @default(cuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name       String
  sku        String?
  price      Decimal          @db.Decimal(12, 2)
  cost       Decimal?         @db.Decimal(12, 2)
  stockQty   Int              @default(0)
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, active])
}

model StockMovement {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId       String
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  type            StockMovementType
  quantity        Int
  notes           String?
  saleItemId      String?
  idempotencyKey  String?
  createdByUserId String?
  createdAt       DateTime          @default(now())

  @@unique([idempotencyKey])
  @@index([tenantId])
  @@index([productId, createdAt])
}

// ---------------------------------------------------------------------------
// Client enrichment
// ---------------------------------------------------------------------------

model ClientTag {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  createdAt DateTime @default(now())

  assignments ClientTagAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ClientTagAssignment {
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tagId      String
  tag        ClientTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())

  @@id([clientId, tagId])
  @@index([tagId])
}

model ClientConsent {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      ConsentType
  granted   Boolean     @default(true)
  grantedAt DateTime    @default(now())
  revokedAt DateTime?
  source    String?

  @@unique([clientId, type])
  @@index([tenantId])
}

model ClientFavorite {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  barberId  String?
  barber    User?    @relation(fields: [barberId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([tenantId, clientId])
}

// ---------------------------------------------------------------------------
// Events, automation & messaging
// ---------------------------------------------------------------------------

model DomainEvent {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventType   String
  payload     String            @db.Text
  status      DomainEventStatus @default(PENDING)
  processedAt DateTime?
  createdAt   DateTime          @default(now())

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model AutomationRule {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  trigger    String
  conditions String?  @db.Text
  actions    String   @db.Text
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, active])
}

model MessageOutbox {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel     String              @default("WHATSAPP")
  recipient   String
  message     String              @db.Text
  status      MessageOutboxStatus @default(PENDING)
  scheduledAt DateTime?
  sentAt      DateTime?
  error       String?
  metadata    String?             @db.Text
  createdAt   DateTime            @default(now())

  @@index([tenantId, status])
  @@index([status, scheduledAt])
}

// ---------------------------------------------------------------------------
// Loyalty, referrals & promotions
// ---------------------------------------------------------------------------

model GiftCard {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code           String
  initialBalance Decimal        @db.Decimal(12, 2)
  balance        Decimal        @db.Decimal(12, 2)
  status         GiftCardStatus @default(ACTIVE)
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())

  @@unique([tenantId, code])
  @@index([tenantId])
}

model LoyaltyAccount {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String   @unique
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger LoyaltyLedger[]

  @@unique([tenantId, clientId])
  @@index([tenantId])
}

model LoyaltyLedger {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId   String
  account     LoyaltyAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        LoyaltyLedgerType
  points      Int
  description String?
  saleId      String?
  createdAt   DateTime          @default(now())

  @@index([tenantId])
  @@index([accountId, createdAt])
}

model Referral {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referrerClientId String
  referrerClient   Client         @relation("ReferrerReferrals", fields: [referrerClientId], references: [id], onDelete: Cascade)
  referredClientId String?
  referredClient   Client?        @relation("ReferredReferrals", fields: [referredClientId], references: [id], onDelete: SetNull)
  referredPhone    String?
  status           ReferralStatus @default(PENDING)
  rewardAmount     Decimal?       @db.Decimal(12, 2)
  createdAt        DateTime       @default(now())
  completedAt      DateTime?

  @@index([tenantId, status])
  @@index([referrerClientId])
}

model ServicePackage {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  serviceIds  String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model PrepaidCredit {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  balance   Decimal   @db.Decimal(12, 2)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, clientId])
}

model Coupon {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  type      CouponType @default(PERCENTAGE)
  value     Decimal    @db.Decimal(12, 2)
  maxUses   Int?
  usedCount Int        @default(0)
  active    Boolean    @default(true)
  expiresAt DateTime?
  createdAt DateTime   @default(now())

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Review {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  rating        Int
  comment       String?      @db.Text
  status        ReviewStatus @default(PENDING)
  createdAt     DateTime     @default(now())

  @@index([tenantId, status])
  @@index([appointmentId])
}

// ---------------------------------------------------------------------------
// Fiscal & permissions
// ---------------------------------------------------------------------------

model FiscalDocument {
  id         String               @id @default(cuid())
  tenantId   String
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleId     String?
  sale       Sale?                @relation(fields: [saleId], references: [id], onDelete: SetNull)
  provider   String
  externalId String?
  status     FiscalDocumentStatus @default(PENDING)
  payload    String?              @db.Text
  issuedAt   DateTime?
  createdAt  DateTime             @default(now())

  @@index([tenantId, status])
  @@index([saleId])
}

model PermissionOverride {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  granted    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([tenantId, userId, permission])
  @@index([tenantId, userId])
}
