DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Pooled Neon URL for the app runtime (Prisma Client)

DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooler) Neon URL for prisma migrate. If omitted, scripts/run-with-direct-url.cjs derives it from DATABASE_URL.

NEXTAUTH_URL="http://localhost:3000"
# Public URL of the app (required for OAuth callbacks and absolute links)

NEXTAUTH_SECRET="gere-um-secret-aleatorio-com-pelo-menos-32-caracteres"
# Session signing secret — min 16 chars; required in production

RATE_LIMIT_SECRET="gere-um-secret-aleatorio-com-pelo-menos-32-caracteres"
# HMAC secret for rate-limit identity hashing — required in production (no insecure fallback)

CRON_SECRET="secret-para-cron-job-min-16-chars"
# Bearer token for /api/cron/* routes — required in production

CREDENTIALS_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# AES-256-GCM key for tenant tokens (WhatsApp, Mercado Pago). Use 64 hex chars or a long passphrase.
# Required in production. Rotate only with credentials:migrate re-encryption plan.

MERCADOPAGO_ACCESS_TOKEN=""
# Platform-level MP token for signup billing (optional if using demo mode)

MERCADOPAGO_WEBHOOK_SECRET=""
# Secret from Mercado Pago webhook config — validates x-signature on incoming webhooks

WHATSAPP_DEMO_MODE="true"
# true = simulate WhatsApp sends without Meta API (dev/staging only)

SIGNUP_DEMO_MODE="false"
# true = skip real MP payment on tenant signup (dev/staging only)

BOOKING_DEMO_MODE="false"
# true = skip real MP payment on public booking (dev/staging only)

PLATFORM_PIX_KEY="sua-chave-pix@email.com"
PLATFORM_PIX_NAME="Cortzo"
PLATFORM_PIX_CITY="SAO PAULO"
PLATFORM_BILLING_EMAIL="suporte@example.com"
# Placeholder domain — replace with the real support email once cortzo.com (or similar) is registered

# Optional — observability & storage (future)
SENTRY_DSN=""
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_PUBLIC_BASE_URL=""
AI_ENABLED="false"
AI_API_KEY=""
